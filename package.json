{
  "name": "streaming-hub",
  "version": "0.3.1",
  "description": "Streaming app with Castlabs Electron for full Widevine DRM support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --linux AppImage",
    "build:dir": "electron-builder --linux dir",
    "build:linux": "electron-builder --linux AppImage",
    "build:mac": "electron-builder --mac zip",
    "build:win": "electron-builder --win portable",
    "build:all": "electron-builder --linux AppImage --mac zip --win portable",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "com.streaming-hub.app",
    "productName": "Streaming Hub",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "asarUnpack": [
      "start.sh",
      "start.cmd"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "http://192.168.4.105:3000/kekskarlo/Streaming-Hub/releases/latest/download"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video",
      "icon": "assets/icon.svg"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "keywords": [
    "streaming",
    "netflix",
    "widevine",
    "castlabs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v42.0.0+wvcus",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "hls.js": "^1.6.16"
  }
}
