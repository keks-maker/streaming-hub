{
  "name": "streaming-hub",
  "private": true,
  "workspaces": [
    "packages/typed-core"
  ],
  "version": "0.9.1",
  "description": "Streaming app with Castlabs Electron for full Widevine DRM support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prestart": "npm run build:all",
    "dev": "electron . --dev",
    "predev": "npm run build:all",
    "build": "electron-builder --linux AppImage",
    "build:dir": "electron-builder --linux dir",
    "build:linux": "electron-builder --linux AppImage",
    "build:mac": "electron-builder --mac zip",
    "build:win": "electron-builder --win portable",
    "build:dist": "electron-builder --linux AppImage --mac zip --win portable",
    "postinstall": "node node_modules/electron/install.js && node scripts/evs-dev-sign.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "audit": "npm audit",
    "outdated": "npm outdated",
    "build:typed-core": "npm run build:all --workspace packages/typed-core",
    "build:renderer": "node scripts/build-renderer.js && node scripts/generate-tray-icons.js",
    "build:all": "npm run build:typed-core && npm run build:renderer",
    "watch": "node scripts/watch-renderer.js",
    "test": "node scripts/with-tmp.js npm run test:suite",
    "test:updater": "node scripts/with-tmp.js node --test tests/tvsources-merge.test.js tests/post-update-reconcile.test.js tests/node-path.test.js tests/app-version.test.js tests/github-releases.test.js tests/updater-bundle.test.js tests/updater-install-safety.test.js tests/updater-asar.test.js tests/update-mode.test.js",
    "test:e2e": "node scripts/with-tmp.js playwright test -c e2e/playwright.config.js",
    "test:suite": "npm test --workspace packages/typed-core && node --test \"tests/*.test.js\"",
    "test:smoke-updater": "node scripts/with-tmp.js node scripts/smoke-updater-gui-path.js",
    "dev:watch": "npm run build:all && (node scripts/watch-renderer.js &) && electron . --dev"
  },
  "build": {
    "appId": "com.streaming-hub.app",
    "productName": "Streaming Hub",
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/evs-afterPack.js",
    "asar": false,
    "files": [
      "**/*",
      "!{.serena,.claude,.vscode,.idea,.github,e2e,test-results,playwright-report,coverage}{,/**}",
      "!{docs,tests,scripts}{,/**}",
      "!assets/screenshots{,/**}",
      "!{.eslintrc.json,.prettierrc,eslint.config.js,.gitignore,CHANGELOG.md,README.md}",
      "!{CLAUDE.md,AGENTS.md,.update-state.json,.update-backup,.env,.env.*,.DS_Store}",
      "!**/*.log"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video",
      "icon": "assets/icon.svg"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.video",
      "icon": "assets/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "keywords": [
    "streaming",
    "netflix",
    "widevine",
    "castlabs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "electron": "github:castlabs/electron-releases#v42.0.0+wvcus",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "hls.js": "^1.6.16",
    "@streaming-hub/typed-core": "*"
  }
}
